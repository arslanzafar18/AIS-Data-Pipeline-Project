[Unit]
Description=Jaeger (traces): OTLP on localhost:4318, UI on localhost:16686. No login: never expose these ports.
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/jaeger
# JAEGER_CMD is set by scripts/install_ops_services.sh from the Jaeger you already run (binary + config path).
EnvironmentFile=/home/ubuntu/jaeger/jaeger.env
ExecStart=/bin/sh -c 'exec $JAEGER_CMD'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
