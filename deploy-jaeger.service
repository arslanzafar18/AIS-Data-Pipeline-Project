[Unit]
Description=Jaeger (traces): OTLP on localhost:4318, UI on localhost:16686. No login: never expose these ports.
After=network.target

[Service]
User=@USER@
WorkingDirectory=@JAEGER_DIR@
# JAEGER_CMD (binary + config path) is written by scripts/install_jaeger.sh.
EnvironmentFile=@JAEGER_DIR@/jaeger.env
ExecStart=/bin/sh -c 'exec $JAEGER_CMD'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
