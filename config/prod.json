{
  "env": "prod",
  "data_root": "data/prod",
  "metrics_dir": "metrics/prod",
  "flush_seconds": 120,
  "spark_master": "local[2]",
  "shuffle_partitions": 8,
  "facility_name_col": "facName",
  "facility_kind_col": "facKind",
  "near_m": 5000,
  "at_m": 500,
  "near_m_onshore": 1500,
  "onshore_kinds": [
    "ONSHORE FACILITY"
  ],
  "facility_filter": {
    "include": {
      "surface": [
        "Y"
      ],
      "phaseName": [
        "IN SERVICE",
        "INSTALLATION"
      ]
    },
    "exclude_kinds": [
      "LANDFALL",
      "OFFSHORE WIND TURBINE"
    ],
    "fixed_col": "FixMov",
    "moveable_kinds_allowed": [
      "FPSO",
      "FSU"
    ]
  },
  "stationary_kn": 0.5,
  "visit_gap_s": 1800,
  "cross_batch_dedupe": true,
  "max_files_per_trigger": 200,
  "lookback_days": 90,
  "gold_recent_days": 2,
  "regular_visitor": {
    "min_days": 3,
    "window_days": 30
  },
  "zone_gap_s": 1800,
  "surveillance": {
    "loiter_max_kn": 2.0,
    "loiter_min_minutes": 120,
    "ais_gap_min_minutes": 30,
    "ais_gap_max_hours": 12
  },
  "gold_shuffle_partitions": 32,
  "driver_memory": "6g",
  "gate": {
    "min_silver_rows": 1000,
    "max_reject_rate": 0.1,
    "max_silver_staleness_min": 30
  }
}
