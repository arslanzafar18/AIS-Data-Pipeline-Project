{
  "env": "dev",
  "data_root": "data/dev",
  "metrics_dir": "metrics/dev",
  "flush_seconds": 120,
  "spark_master": "local[1]",
  "shuffle_partitions": 4,
  "facility_name_col": "facName",
  "facility_kind_col": "facKind",
