[Unit]
Description=Global Fishing Watch radar detections into Bronze (daily, run by deploy-gfw-refresh.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
Environment=PYTHONPATH=@REPO@
ExecStart=@VENV@/bin/python reference/fetch_gfw_sar.py
