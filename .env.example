# Environment selector: dev (default) or prod -> config/<env>.json
APP_ENV=prod
# Barentswatch: register at barentswatch.no -> My page -> create API client (scope: ais)
BW_CLIENT_ID=you@example.com:ais-pipeline
BW_CLIENT_SECRET=changeme
# Global Fishing Watch API token (free, non-commercial): globalfishingwatch.org/our-apis. Without it the radar fetch is skipped.
GFW_TOKEN=
# Tracing: send OpenTelemetry spans to the local Jaeger (scripts/install_jaeger.sh). Leave unset to switch tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
