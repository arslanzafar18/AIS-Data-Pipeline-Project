[Unit]
Description=AIS Silver (every 2 min) and Gold (hourly) loop
After=network-online.target
[Service]
WorkingDirectory=/home/ubuntu/AIS-Data-Pipeline-Project
EnvironmentFile=/home/ubuntu/AIS-Data-Pipeline-Project/.env
Environment=PYTHONPATH=/home/ubuntu/AIS-Data-Pipeline-Project
Environment=JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ExecStart=/home/ubuntu/AIS-Data-Pipeline-Project/scripts/run_pipeline_loop.sh
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
