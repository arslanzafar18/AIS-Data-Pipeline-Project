[Unit]
Description=Norwegian fishing vessel register into Bronze (weekly, run by deploy-fishing-refresh.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
Environment=PYTHONPATH=@REPO@
ExecStart=@VENV@/bin/python reference/fetch_fishing_vessels.py
