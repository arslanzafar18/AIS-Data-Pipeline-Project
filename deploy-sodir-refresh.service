[Unit]
Description=Sodir facilities and pipelines refresh into Bronze (weekly, run by deploy-sodir-refresh.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
Environment=PYTHONPATH=@REPO@
ExecStart=@VENV@/bin/python reference/fetch_sodir.py
ExecStart=@VENV@/bin/python reference/fetch_pipelines.py
