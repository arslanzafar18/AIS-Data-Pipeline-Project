[Unit]
Description=Delete live Bronze files older than bronze_retention_days that Silver has processed (run by deploy-bronze-retention.timer)

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
Environment=PYTHONPATH=@REPO@
ExecStart=@VENV@/bin/python scripts/bronze_retention.py --apply
